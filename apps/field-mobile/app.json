{
  "expo": {
    "name": "Uroflow Field",
    "slug": "uroflow-field-mobile",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Microphone is used to capture uroflow acoustic signal.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F2EA",
          "imageWidth": 220
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uroflow.field",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to capture uroflow recording area.",
        "NSMicrophoneUsageDescription": "Microphone is used to capture uroflow acoustic signal.",
        "NSMotionUsageDescription": "Motion sensors are used to detect phone movement artifacts."
      }
    },
    "android": {
      "package": "com.uroflow.field",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F2A"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    }
  }
}
